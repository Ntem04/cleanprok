{
  "name": "cleanpro-workspace",
  "private": true,
  "workspaces": [
    "apps/*",
    "backend"
  ],
  "scripts": {
    "dev:vitrine": "npm run dev --workspace=apps/vitrine",
    "dev:ngrok": "npm run dev --workspace=apps/vitrine -- --host 0.0.0.0",
    "serve:ngrok": "npm run serve:ngrok --workspace=apps/vitrine",
    "security:test": "snyk test",
    "preinstall": "npx snyk test",
    "prepare": "husky"
  }
}
