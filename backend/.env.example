# Port d'écoute du serveur Express
PORT=5000

# Environnement applicatif (development | production | test)
NODE_ENV=development

# Origine du client frontend autorisée par CORS (Sécurité OWASP)
CLIENT_URL=http://localhost:3000

# URL de connexion à la base de données PostgreSQL pour Prisma
DATABASE_URL=postgresql://user:password@localhost:5432/cleanpro_db?schema=public

# Clé secrète de signature des jetons JWT (minimum 32 caractères aléatoires sécurisés)
JWT_SECRET=votre_cle_secrete_jwt_ultra_securisee_ici_minimum_32_caracteres

